# Base URL of the Finuxia Django backend.
# The local docker stack serves it on 8000 (see Docs/running-locally.md); a bare
# `manage.py runserver 4000` uses 4000.
VITE_API_URL=http://localhost:4000

# --- Error tracking (OPS-01, src/lib/errorTracking.js) ----------------------
# Leave VITE_SENTRY_DSN empty and error tracking is off: no SDK is loaded, no chunk is fetched and
# nothing is sent anywhere. That is how development and the test suite run, and a build made before
# a Sentry project exists works unchanged.
#
# The DSN is not a secret in the way an API key is — it ships inside the bundle and is visible to
# anyone who opens the page, because the browser has to be able to post to it. It is write-only.
VITE_SENTRY_DSN=

# Which deployment an event came from, so a future staging environment cannot pollute production's
# error list. Defaults to "development" in a dev build and "production" otherwise.
VITE_SENTRY_ENVIRONMENT=

# The commit the bundle was built from, so a regression maps to a deploy rather than to a date.
# Nothing sets this yet; empty is better than wrong, because Sentry then groups the event with no
# release instead of blaming whichever build happened to be last.
VITE_SENTRY_RELEASE=

# Performance tracing, the expensive part of the bill. Off (0) unless there is a specific question
# worth paying to answer.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
